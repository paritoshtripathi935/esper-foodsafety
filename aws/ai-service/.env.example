AWS_REGION=us-east-1
# Bedrock cross-region inference profile (the `us.` prefix is required;
# the raw model ID anthropic.claude-sonnet-4-6 rejects on-demand throughput).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Per Esper hackathon rules: bucket name must start with your team prefix.
S3_BUCKET=<team>-safetemp-haccp
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
